rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify auth
    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny for unmapped collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test_connection/{id} {
      allow read: if isSignedIn();
    }

    // App standard collections
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    match /mails/{mailId} {
      allow read, write: if isSignedIn();
    }

    match /staff/{staffId} {
      allow read, write: if isSignedIn();
    }

    match /projects/{projectId} {
      allow read, write: if isSignedIn();
    }

    match /projects_operasional/{id} {
      allow read, write: if isSignedIn();
    }

    match /water_logs/{waterLogId} {
      allow read, write: if isSignedIn();
    }

    match /damage_reports/{damageReportId} {
      allow read, write: if isSignedIn();
    }

    match /assets/{assetId} {
      allow read, write: if isSignedIn();
    }

    match /finances/{financeId} {
      allow read, write: if isSignedIn();
    }

    match /daerah_irigasi/{id} {
      allow read, write: if isSignedIn();
    }

    match /river_stations/{id} {
      allow read, write: if isSignedIn();
    }

    match /asset_distributions/{id} {
      allow read, write: if isSignedIn();
    }

    match /consumables/{id} {
      allow read, write: if isSignedIn();
    }

    match /activity_accounts/{id} {
      allow read, write: if isSignedIn();
    }

    match /spj/{id} {
      allow read, write: if isSignedIn();
    }

    match /bapp/{id} {
      allow read, write: if isSignedIn();
    }

    match /contracts/{contractId} {
      allow read, write: if isSignedIn();
    }

    match /bank_accounts/{id} {
      allow read, write: if isSignedIn();
    }

    match /job_proposals_operasional/{id} {
      allow read, write: if isSignedIn();
    }

    match /job_proposals_pembangunan/{id} {
      allow read, write: if isSignedIn();
    }

    match /inspection_logs/{id} {
      allow read, write: if isSignedIn();
    }

    match /profile_metadata/{id} {
      allow read, write: if isSignedIn();
    }

    match /footer_metadata/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
