{
  "entities": {
    "User": {
      "title": "User",
      "description": "Application User metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "section": { "type": "string" }
      },
      "required": ["id", "username", "name", "role"]
    },
    "Mail": {
      "title": "Mail",
      "description": "Surat Masuk atau Surat Keluar UPTD",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "sender": { "type": "string" },
        "recipient": { "type": "string" },
        "subject": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "type", "referenceNumber", "sender", "recipient", "subject", "date", "status"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Kepegawaian UPTD",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nip": { "type": "string" },
        "pangkat": { "type": "string" },
        "golongan": { "type": "string" },
        "position": { "type": "string" }
      },
      "required": ["id", "name", "nip"]
    },
    "Project": {
      "title": "Project",
      "description": "Paket Pekerjaan Konstruksi dan Rehabilitasi",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "budget": { "type": "number" },
        "contractor": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "budget"]
    },
    "WaterLog": {
      "title": "WaterLog",
      "description": "Catatan Tinggi Muka Air dan Debit Sungai",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "location": { "type": "string" },
        "tma": { "type": "number" },
        "debit": { "type": "number" },
        "status": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "location", "tma", "debit", "status", "date"]
    },
    "DamageReport": {
      "title": "DamageReport",
      "description": "Pengaduan Kerusakan Infrastruktur Irigasi",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporterName": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "reporterName", "location", "description", "date", "status"]
    },
    "Asset": {
      "title": "Asset",
      "description": "Aset Perlengkapan Dinas UPTD",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "condition": { "type": "string" },
        "location": { "type": "string" },
        "quantity": { "type": "number" }
      },
      "required": ["id", "name", "code", "condition", "quantity"]
    },
    "FinanceTransaction": {
      "title": "FinanceTransaction",
      "description": "Transaksi Keuangan atau Pembiayaan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "date", "description", "amount", "type", "category"]
    },
    "Contract": {
      "title": "Contract",
      "description": "Surat Perjanjian Kerja / Kontrak Pembangunan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectName": { "type": "string" },
        "contractNumber": { "type": "string" },
        "contractDate": { "type": "string" },
        "amount": { "type": "number" }
      },
      "required": ["id", "projectName", "contractNumber", "contractDate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Sistem Pengguna"
    },
    "/mails/{mailId}": {
      "schema": "Mail",
      "description": "Manajemen Surat Menyurat"
    },
    "/staff/{staffId}": {
      "schema": "Staff",
      "description": "Manajemen Kepegawaian"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Rencana Pekerjaan Pembangunan"
    },
    "/water_logs/{waterLogId}": {
      "schema": "WaterLog",
      "description": "Pemantauan Tinggi Muka Air"
    },
    "/damage_reports/{damageReportId}": {
      "schema": "DamageReport",
      "description": "Pengaduan Kerusakan Irigasi"
    },
    "/assets/{assetId}": {
      "schema": "Asset",
      "description": "Aset Peralatan Dinas"
    },
    "/finances/{financeId}": {
      "schema": "FinanceTransaction",
      "description": "Pemasukan dan Pengeluaran Rutin"
    },
    "/contracts/{contractId}": {
      "schema": "Contract",
      "description": "Kontrak Kerja Rekanan"
    }
  }
}
